<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/BackgroundLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/LightPurple"
    tools:context=".MainActivity">

    <!-- Left / right tap zones (behind everything) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <View
            android:id="@+id/back_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.28" />

        <View
            android:id="@+id/next_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.72" />

    </LinearLayout>

    <!-- Subtle tap hints (fade out after the first card) -->
    <ImageView
        android:id="@+id/hint_left"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="8dp"
        android:alpha="0.35"
        android:clickable="false"
        android:src="@drawable/ic_chevron_left"
        android:contentDescription="@string/previous_card" />

    <ImageView
        android:id="@+id/hint_right"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:alpha="0.45"
        android:clickable="false"
        android:src="@drawable/ic_chevron_right"
        android:contentDescription="@string/next_card" />

    <!--
        Prompt text, with an optional bird photo beside it.

        Both children are 0dp + weight 1, but LinearLayout leaves GONE children out of
        weight distribution entirely — so with the photo hidden the text column resolves
        to the full parent width, exactly the box match_parent used to give it, and
        ordinary cards are unchanged.

        Nothing in here is clickable, so touches fall straight through to the back/next
        zones underneath.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:clickable="false"
        android:focusable="false">

        <ImageView
            android:id="@+id/bird_image"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="40dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false"
            android:contentDescription="@string/bird_photo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="false"
            android:focusable="false">

            <TextView
                android:id="@+id/message_text"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="64dp"
                android:paddingVertical="80dp"
                android:text="@string/begin_hint"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeStepGranularity="1sp"
                android:clickable="false" />

            <!-- Photo credit — shown only once the bird's name is revealed. -->
            <TextView
                android:id="@+id/bird_credit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp"
                android:textColor="@color/white_70"
                android:textSize="12sp"
                android:visibility="gone"
                android:clickable="false"
                android:focusable="false" />

        </LinearLayout>

    </LinearLayout>

    <!-- Category label + info badge (top centre) -->
    <LinearLayout
        android:id="@+id/tile_type_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tile_type_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/tile_type_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/infosymbol"
            android:contentDescription="@string/category_info" />

    </LinearLayout>

    <!-- Manage players (top-left) -->
    <ImageButton
        android:id="@+id/players_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_circle_button"
        android:src="@drawable/ic_person_add"
        android:scaleType="centerInside"
        android:contentDescription="@string/manage_players" />

    <!-- Ghost tally (bottom centre) — only visible once someone is haunted -->
    <TextView
        android:id="@+id/ghost_tally"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:textColor="@color/white_70"
        android:textSize="15sp"
        android:textStyle="bold"
        android:clickable="false"
        android:focusable="false" />

    <!-- What's in play (top-right) -->
    <ImageButton
        android:id="@+id/in_play_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_circle_button"
        android:src="@drawable/ic_in_play"
        android:scaleType="centerInside"
        android:contentDescription="@string/in_play_title" />

    <!-- Full-screen flash for the Ultra Challenge reveal (transparent to touch) -->
    <View
        android:id="@+id/flash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ultra_flash"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
