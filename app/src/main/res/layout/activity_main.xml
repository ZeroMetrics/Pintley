<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/BackgroundLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/LightPurple"
    tools:context=".MainActivity">

    <!-- Left / right tap zones (behind everything) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <View
            android:id="@+id/back_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.28" />

        <View
            android:id="@+id/next_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.72" />

    </LinearLayout>

    <!-- Prompt text -->
    <TextView
        android:id="@+id/message_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingHorizontal="48dp"
        android:paddingVertical="80dp"
        android:text="@string/begin_hint"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="18sp"
        android:autoSizeMaxTextSize="40sp"
        android:autoSizeStepGranularity="1sp"
        android:clickable="false" />

    <!-- Category label + info badge (top centre) -->
    <LinearLayout
        android:id="@+id/tile_type_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tile_type_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/tile_type_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/infosymbol"
            android:contentDescription="@string/category_info" />

    </LinearLayout>

</FrameLayout>
